---
import Base from '../layouts/Base.astro';
// Formulario del WG4 (difusión y formación). Reproduce el formulario Shiny de
// Coara_WG4_app/repo_form/app/app.R: mismos campos, valores y reglas. Los envíos van
// a un Google Apps Script (apps_script/wg4_form/Code.gs) que añade una fila a la hoja
// del WG4, de modo que scripts/export_activities.R no cambia.
const ENDPOINT = 'https://script.google.com/macros/s/AKfycbynhSvSGF5ADWgpqFYPSZIIwiIaR4fseHJgyENj_TpUkcs-4K8x1bsqW0Unhpnsd0cJ/exec';

const institutions = [
  'ACCUA', 'ACCUEE', 'ACPUA', 'AMIT', 'ANECA',
  'AQU Catalunya', 'AQuAS', 'AQUIB', 'ARAID', 'AVAP',
  'Biogipuzkoa', 'CNEAI', 'COMILLAS', 'COSCE', 'CREAF',
  'CRG', 'CRUE', 'CSIC', 'DEUSTO', 'EHU-UPV', 'EU-LIFE',
  'FECYT', 'FIBHULP', 'FISABIO', 'IBEC', 'IBSAL',
  'IBS Granada', 'IDIBAPS', 'IIS Aragón', 'IIS Navarra',
  'INCLIVA', 'IR Sant Pau', 'IREC', 'ISCIII', 'ISGlobal',
  'UA', 'UAB', 'UAL', 'UAM', 'UAX', 'UB', 'UC', 'UCAM',
  'UCHCEU', 'UCLM', 'UCM', 'UCO', 'UdL', 'UIB', 'UJA',
  'UJI', 'UMA', 'UMH', 'UMU', 'UNIOVI', 'UNIZAR', 'UOC',
  'UPC', 'UPCT', 'UPO', 'UPV', 'URJC', 'URL', 'URV',
  'US', 'UV', 'UVIGO', 'VIU',
];
const institutionTypes = [
  'Agencia de evaluación', 'Centro de investigación', 'Universidad',
  'Asociación de universidades', 'Otro',
];
const disseminationCategories = [
  'Seminarios informativos y documentos',
  'Páginas web dedicadas a CoARA',
  'Noticias de CoARA en boletines institucionales',
  'Planes de acción CoARA',
  'Otro',
];
const contextChoices = ['Nacional', 'Internacional'];
const formatChoices = [
  'Presencial', 'En línea', 'Híbrido',
  'Documento/Publicación', 'Página web', 'Boletín', 'Otro',
];
const audienceChoices = [
  'Investigadores', 'Evaluadores', 'Personal administrativo',
  'Doctorandos', 'Comités de selección', 'Público general', 'Otro',
];
const topicChoices = [
  'Métricas responsables', 'Ciencia abierta', 'CV narrativo',
  'Principios CoARA', 'Principios DORA', 'HRS4R',
  'Ética e integridad', 'Evaluación cualitativa', 'Datos FAIR', 'Otro',
];
---
<Base title="Formulario de difusión y formación" description="Formulario del Grupo de Trabajo 4 del Capítulo Nacional Español de CoARA para registrar actividades de difusión y formación.">
  <div class="wg4">
    <div class="banner">
      <img src="/images/logo.png" alt="CoARA National Chapter Spain - España" />
      <p class="eyebrow">CoARA WG4</p>
      <h1>Formulario de difusión y formación</h1>
    </div>

    <form id="wg4-form" class="sheet" data-endpoint={ENDPOINT} novalidate>
      <h2 class="sec">Datos institucionales</h2>
      <div class="row">
        <label>Institución *
          <input name="institution" list="institution-list" autocomplete="off"
                 placeholder="Seleccione o escriba su institución" required />
          <datalist id="institution-list">
            {institutions.map((i) => <option value={i} />)}
          </datalist>
        </label>
        <label>Tipo de institución *
          <select name="institution_type" required>
            <option value="">Seleccione...</option>
            {institutionTypes.map((t) => <option>{t}</option>)}
          </select>
        </label>
      </div>
      <div class="row">
        <label>Persona de contacto
          <input name="contact_name" autocomplete="name" />
        </label>
        <label>Correo electrónico
          <input name="contact_email" type="email" autocomplete="email" />
        </label>
      </div>
      <label class="check">
        <input type="checkbox" name="contact_public" />
        Autorizo que el correo electrónico de contacto se muestre en coara.es junto a esta actividad
      </label>
      <p class="note">
        Las actividades registradas, con el nombre de la persona de contacto, se publican en la
        sección <a href="/difusion-formacion/">Difusión y formación</a> de coara.es. El correo
        electrónico solo se publica si se marca la casilla anterior.
      </p>

      <h2 class="sec">Clasificación de la actividad</h2>
      <label>Tipo de actividad *
        <select name="activity_type" required>
          <option value="">Seleccione...</option>
          <option value="Difusion">Difusión (sensibilización)</option>
          <option value="Formacion">Formación</option>
        </select>
      </label>
      <div class="row" id="dissemination-fields" hidden>
        <label>Categoría de difusión
          <select name="dissemination_category">
            <option value="">Seleccione...</option>
            {disseminationCategories.map((c) => <option>{c}</option>)}
          </select>
        </label>
        <label>Contexto
          <select name="context">
            <option value="">Seleccione...</option>
            {contextChoices.map((c) => <option>{c}</option>)}
          </select>
        </label>
      </div>

      <h2 class="sec">Detalles de la actividad</h2>
      <label>Nombre de la actividad *
        <input name="activity_title" required />
      </label>
      <label>Descripción *
        <textarea name="description" rows="5" required
                  placeholder="Describa la actividad, incluyendo ponentes, temáticas, formato, etc."></textarea>
      </label>
      <div class="row three">
        <label class="date">Fecha de inicio
          <input name="date_start" type="date" />
        </label>
        <label class="date">Fecha de fin
          <input name="date_end" type="date" />
        </label>
        <label>Período de implementación
          <input name="period_text" placeholder="Ej: Desde 2022, Curso 2024-2025" />
        </label>
      </div>
      <label>Gobernanza / Coordinación
        <textarea name="governance" rows="2"
                  placeholder="Quién coordina esta actividad dentro de la institución"></textarea>
      </label>
      <div class="row">
        <fieldset>
          <legend>Público objetivo</legend>
          {audienceChoices.map((a) => <label class="check"><input type="checkbox" name="target_audience" value={a} /> {a}</label>)}
        </fieldset>
        <fieldset>
          <legend>Temáticas</legend>
          {topicChoices.map((t) => <label class="check"><input type="checkbox" name="topics" value={t} /> {t}</label>)}
        </fieldset>
      </div>
      <label>Formato
        <select name="format">
          <option value="">Seleccione...</option>
          {formatChoices.map((f) => <option>{f}</option>)}
        </select>
      </label>
      <div class="row">
        <label>Enlace (URL)
          <input name="url" type="url" placeholder="https://..." />
        </label>
        <label>Enlace adicional
          <input name="url2" type="url" placeholder="https://..." />
        </label>
      </div>
      <label>Notas adicionales
        <textarea name="additional_notes" rows="3"></textarea>
      </label>

      <!-- Campo trampa: invisible para las personas; si llega relleno, el envío se descarta. -->
      <label class="trap" aria-hidden="true">Sitio web
        <input name="website" tabindex="-1" autocomplete="off" />
      </label>

      <div id="form-errors" class="errors" role="alert" hidden></div>
      <div class="actions">
        <button type="submit" class="btn btn-lg">Enviar</button>
      </div>
    </form>

    <div id="form-done" class="sheet done" hidden tabindex="-1">
      <h2 class="sec">Envío realizado con éxito</h2>
      <p>Su actividad ha sido registrada correctamente.</p>
      <dl>
        <dt>Institución</dt><dd id="done-institution"></dd>
        <dt>Tipo de actividad</dt><dd id="done-type"></dd>
        <dt>Nombre</dt><dd id="done-title"></dd>
      </dl>
      <p><button type="button" class="btn" id="form-again">Enviar otra actividad</button></p>
    </div>

    <details class="sheet help">
      <summary>Instrucciones</summary>
      <h3>Objetivo</h3>
      <p>
        Este formulario recoge información sobre actividades de <strong>difusión</strong> y
        <strong>formación</strong> relacionadas con la reforma de la evaluación de la
        investigación, en el marco del Capítulo Nacional Español de CoARA (NCS).
      </p>
      <h3>Tipos de actividad</h3>
      <ul>
        <li><strong>Difusión (sensibilización):</strong> seminarios informativos, páginas web
          dedicadas a CoARA, noticias en boletines institucionales, planes de acción, etc.</li>
        <li><strong>Formación:</strong> cursos, talleres, seminarios de capacitación, webinars y
          conferencias formativas sobre evaluación responsable, ciencia abierta, métricas
          responsables, etc.</li>
      </ul>
      <h3>Campos obligatorios</h3>
      <p>
        Son obligatorios los campos marcados con *: Institución, Tipo de institución, Tipo de
        actividad, Nombre de la actividad y Descripción.
      </p>
      <h3>Instituciones</h3>
      <p>
        La lista incluye las instituciones miembro del NCS. Si su institución no aparece, puede
        escribir el nombre directamente.
      </p>
      <h3>Publicación</h3>
      <p>
        Las actividades registradas se publican en la sección Difusión y formación de coara.es,
        con la institución y el nombre de la persona de contacto. El correo electrónico solo se
        muestra si se autoriza en el formulario.
      </p>
      <h3>Contacto</h3>
      <p>
        Para dudas o incidencias con el formulario, contacte con el Grupo de Trabajo 4 (WG4) del
        Capítulo Nacional Español de CoARA.
      </p>
    </details>
  </div>
</Base>

<script>
  const form = document.getElementById('wg4-form') as HTMLFormElement;
  const done = document.getElementById('form-done') as HTMLElement;
  const errorsBox = document.getElementById('form-errors') as HTMLElement;
  const dissemination = document.getElementById('dissemination-fields') as HTMLElement;
  const dateFields = form.querySelectorAll<HTMLElement>('label.date');
  const button = form.querySelector('button[type=submit]') as HTMLButtonElement;
  const endpoint = form.dataset.endpoint || '';
  let loadedAt = Date.now();

  const field = (n: string) => form.elements.namedItem(n) as HTMLInputElement;
  const value = (n: string) => (field(n)?.value ?? '').trim();
  const checked = (n: string) =>
    Array.from(form.querySelectorAll<HTMLInputElement>(`input[name="${n}"]:checked`)).map((x) => x.value);

  // Los campos de difusión solo se muestran para ese tipo de actividad, y las fechas
  // se ocultan para las páginas web y los planes de acción, como en el formulario Shiny.
  function update() {
    const isDiss = value('activity_type') === 'Difusion';
    dissemination.hidden = !isDiss;
    const noDates = isDiss && ['Páginas web dedicadas a CoARA', 'Planes de acción CoARA']
      .includes(value('dissemination_category'));
    dateFields.forEach((l) => { l.hidden = noDates; });
  }
  form.addEventListener('change', update);

  function validate(): string[] {
    const e: string[] = [];
    if (!value('institution')) e.push('Institución');
    if (!value('institution_type')) e.push('Tipo de institución');
    if (!value('activity_type')) e.push('Tipo de actividad');
    if (!value('activity_title')) e.push('Nombre de la actividad');
    if (!value('description')) e.push('Descripción');
    const mail = value('contact_email');
    if (mail && !/^[^@\s]+@[^@\s]+\.[^@\s]+$/.test(mail)) e.push('Correo electrónico (formato no válido)');
    if (value('url') && !/^https?:\/\//.test(value('url'))) e.push('URL (debe empezar con http:// o https://)');
    if (value('url2') && !/^https?:\/\//.test(value('url2'))) e.push('URL adicional (debe empezar con http:// o https://)');
    const s = value('date_start'), f = value('date_end');
    if (s && f && f < s) e.push('La fecha de fin debe ser posterior a la de inicio');
    return e;
  }

  function showErrors(list: string[], title = 'Por favor, revise los siguientes campos:') {
    errorsBox.innerHTML = '';
    const strong = document.createElement('strong');
    strong.textContent = title;
    const ul = document.createElement('ul');
    list.forEach((t) => { const li = document.createElement('li'); li.textContent = t; ul.appendChild(li); });
    errorsBox.append(strong, ul);
    errorsBox.hidden = false;
  }

  form.addEventListener('submit', async (ev) => {
    ev.preventDefault();
    errorsBox.hidden = true;
    const errs = validate();
    if (errs.length) { showErrors(errs); return; }

    const datesShown = !dateFields[0].hidden;
    const data = {
      institution: value('institution'),
      institution_type: value('institution_type'),
      contact_name: value('contact_name'),
      contact_email: value('contact_email'),
      contact_public: (field('contact_public') as HTMLInputElement).checked,
      activity_type: value('activity_type'),
      dissemination_category: value('activity_type') === 'Difusion' ? value('dissemination_category') : '',
      context: value('activity_type') === 'Difusion' ? value('context') : '',
      activity_title: value('activity_title'),
      description: value('description'),
      date_start: datesShown ? value('date_start') : '',
      date_end: datesShown ? value('date_end') : '',
      period_text: value('period_text'),
      governance: value('governance'),
      target_audience: checked('target_audience'),
      topics: checked('topics'),
      format: value('format'),
      url: value('url'),
      url2: value('url2'),
      additional_notes: value('additional_notes'),
      website: value('website'),
      elapsed: (Date.now() - loadedAt) / 1000,
    };

    button.disabled = true;
    button.textContent = 'Enviando...';
    try {
      // text/plain evita la consulta previa CORS, que Apps Script no admite.
      const res = await fetch(endpoint, { method: 'POST', body: JSON.stringify(data) });
      const out = await res.json();
      if (!out.ok) {
        if (Array.isArray(out.errors) && !out.errors.includes('server')) showErrors(out.errors);
        else throw new Error('server');
        return;
      }
      (document.getElementById('done-institution') as HTMLElement).textContent = data.institution;
      (document.getElementById('done-type') as HTMLElement).textContent =
        data.activity_type === 'Difusion' ? 'Difusión (sensibilización)' : 'Formación';
      (document.getElementById('done-title') as HTMLElement).textContent = data.activity_title;
      form.hidden = true;
      done.hidden = false;
      done.focus();
      done.scrollIntoView({ behavior: 'smooth', block: 'start' });
    } catch {
      showErrors(
        ['No se ha podido guardar el envío. Por favor, inténtelo de nuevo.',
         'Si el problema persiste, escriba a nationalchapterspain@coara.es.'],
        'Error al enviar',
      );
    } finally {
      button.disabled = false;
      button.textContent = 'Enviar';
    }
  });

  document.getElementById('form-again')?.addEventListener('click', () => {
    form.reset();
    update();
    errorsBox.hidden = true;
    done.hidden = true;
    form.hidden = false;
    loadedAt = Date.now();
    form.scrollIntoView({ behavior: 'smooth', block: 'start' });
  });
</script>

<style>
  /* Aspecto del formulario Shiny: logotipo, tarjeta blanca sobre crema y secciones con filete naranja. */
  .wg4 { max-width: 820px; margin: 0 auto; padding: 1.5rem var(--gutter) 4rem; }
  .banner { text-align: center; padding: 0.5rem 0 1.2rem; }
  .banner img { width: 100%; max-width: 320px; }
  .banner h1 { font-size: clamp(1.5rem, 3.5vw, 2rem); margin: 0.2rem 0 0; }
  .sheet { background: #fff; border: 1px solid var(--line); border-radius: 14px; padding: 28px 32px 36px; box-shadow: 0 2px 14px rgba(42, 42, 42, 0.05); margin-bottom: 1.5rem; }
  .sec { font-family: var(--serif); font-size: 1.2rem; font-weight: 600; color: var(--ink); border-left: 4px solid var(--orange); padding: 2px 0 2px 14px; margin: 6px 0 18px; }
  .sec:not(:first-child) { margin-top: 2rem; }
  label { display: block; font-weight: 500; font-size: 0.95rem; margin-bottom: 1rem; }
  label[hidden], .row[hidden] { display: none; }
  input:not([type=checkbox]), select, textarea {
    display: block; width: 100%; margin-top: 0.35rem; font: inherit; font-weight: 400; color: var(--ink);
    background: #fff; border: 1px solid #DED5C8; border-radius: 8px; padding: 0.5rem 0.7rem;
  }
  textarea { resize: vertical; }
  input:focus, select:focus, textarea:focus { outline: none; border-color: var(--orange); box-shadow: 0 0 0 3px rgba(224, 112, 48, 0.2); }
  .row { display: grid; grid-template-columns: 1fr 1fr; gap: 0 1.2rem; }
  .row.three { grid-template-columns: 1fr 1fr 1fr; }
  fieldset { border: 0; padding: 0; margin: 0 0 1rem; }
  legend { font-weight: 500; font-size: 0.95rem; margin-bottom: 0.4rem; }
  .check { display: flex; gap: 0.5rem; align-items: baseline; font-weight: 400; margin-bottom: 0.35rem; }
  .check input { accent-color: var(--orange-dark); }
  .note { font-size: 0.85rem; color: var(--ink-soft); margin: 0.2rem 0 0; }
  .trap { position: absolute; left: -10000px; width: 1px; height: 1px; overflow: hidden; }
  .errors { border: 1px solid #E8B4B4; background: #FDF1F1; color: #7A1A1A; border-radius: 8px; padding: 0.8rem 1rem; margin: 1rem 0 0; font-size: 0.92rem; }
  .errors ul { margin: 0.4rem 0 0; padding-left: 1.2rem; }
  .actions { text-align: center; padding: 20px 0 4px; }
  .btn-lg { font-size: 1.05rem; padding: 0.75rem 2.2rem; border: 0; cursor: pointer; font-family: inherit; }
  .btn { border: 0; cursor: pointer; font-family: inherit; }
  .btn:disabled { opacity: 0.6; cursor: wait; }
  .done dl { display: grid; grid-template-columns: max-content 1fr; gap: 0.3rem 1rem; margin: 1rem 0 1.5rem; }
  .done dt { font-weight: 600; }
  .done dd { margin: 0; }
  .done:focus { outline: none; }
  .help summary { cursor: pointer; font-family: var(--serif); font-weight: 600; font-size: 1.1rem; }
  .help h3 { font-size: 1rem; margin: 1.2rem 0 0.3rem; }
  @media (max-width: 767px) {
    .sheet { padding: 18px 16px 26px; border-radius: 10px; }
    .row, .row.three { grid-template-columns: 1fr; }
    .banner img { max-width: 240px; }
  }
</style>
