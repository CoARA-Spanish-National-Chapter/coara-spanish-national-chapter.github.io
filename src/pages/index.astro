---
import Base from '../layouts/Base.astro';
import { sections } from '../data/sections';
import { events } from '../data/events';
const fmt = new Intl.DateTimeFormat('es-ES', { day: 'numeric', month: 'long', year: 'numeric', timeZone: 'UTC' });
const latest = events.slice(0, 3);
---
<Base title="Inicio">
  <section class="hero">
    <div class="wrap hero__inner">
      <div>
        <p class="eyebrow">Coalition for Advancing Research Assessment</p>
        <h1>Capítulo Nacional Español de CoARA</h1>
        <p class="lead">
          El Capítulo reúne a las organizaciones españolas firmantes del Acuerdo sobre la Reforma de la
          Evaluación de la Investigación y coordina su trabajo para aplicarlo en España.
        </p>
        <p class="actions">
          <a class="btn" href="/capitulo/">Conocer el Capítulo</a>
          <a class="btn btn--ghost" href="/difusion-formacion/">Registrar una actividad</a>
        </p>
      </div>
      <img src="/images/mark.png" alt="" width="174" height="174" class="hero__mark" />
    </div>
  </section>

  <section class="wrap facts">
    <div class="card"><span class="num">2024</span><span>Presentación oficial del Capítulo</span></div>
    <div class="card"><span class="num">80+</span><span>Instituciones españolas firmantes del Acuerdo</span></div>
    <div class="card"><span class="num">4</span><span>Grupos de trabajo temáticos</span></div>
  </section>

  <section class="wrap page">
    <h2>Secciones</h2>
    <ul class="cards">
      {sections.map((s) => (
        <li class="card">
          <a href={s.href}><h3>{s.label}</h3></a>
          <p>{s.summary}</p>
        </li>
      ))}
    </ul>

    <h2>Novedades</h2>
    <ul class="doclist">
      {latest.map((e) => (
        <li>
          <p class="meta">{e.dateLabel ?? fmt.format(new Date(e.date))}</p>
          <strong>{e.title}</strong>
        </li>
      ))}
    </ul>
    <p><a href="/actividades/">Todas las actividades</a></p>
  </section>
</Base>

<style>
  .hero { background: #fff; border-bottom: 1px solid var(--line); padding-block: 3rem; }
  .hero__inner { display: flex; align-items: center; justify-content: space-between; gap: 2rem; }
  .hero__inner > div { max-width: 44rem; }
  .hero__mark { width: 150px; flex-shrink: 0; }
  .actions { display: flex; flex-wrap: wrap; gap: 0.7rem; margin-top: 1.4rem; }
  .facts { display: grid; grid-template-columns: repeat(auto-fit, minmax(13rem, 1fr)); gap: 1rem; margin-top: 2rem; }
  .facts .card { display: flex; flex-direction: column; gap: 0.2rem; border-top: 4px solid var(--orange); }
  .facts .num { font-family: var(--serif); font-size: 2rem; font-weight: 600; color: var(--orange-dark); line-height: 1.1; }
  .cards { list-style: none; padding: 0; margin: 0; display: grid; gap: 1rem; grid-template-columns: repeat(auto-fill, minmax(15rem, 1fr)); }
  .cards h3 { margin: 0 0 0.4rem; }
  .cards a { text-decoration: none; }
  .cards p { margin: 0; font-size: 0.92rem; color: var(--ink-soft); }
  @media (max-width: 700px) { .hero__mark { display: none; } }
</style>
