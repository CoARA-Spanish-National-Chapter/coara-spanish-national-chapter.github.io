---
import Section from '../layouts/Section.astro';
import { events } from '../data/events';
const fmt = new Intl.DateTimeFormat('es-ES', { day: 'numeric', month: 'long', year: 'numeric', timeZone: 'UTC' });
---
<Section>
  <h2>Próximas actividades</h2>
  <div class="pending">Agenda de actividades del Capítulo y de sus miembros.</div>

  <h2>Actividades anteriores</h2>
  <ul class="doclist">
    {events.map((e) => (
      <li>
        <p class="meta">{e.dateLabel ?? fmt.format(new Date(e.date))}</p>
        <strong>{e.href ? <a href={e.href}>{e.title}</a> : e.title}</strong>
        <p class="meta">{e.text}</p>
      </li>
    ))}
  </ul>
</Section>
